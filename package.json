{
  "name": "vertex-flow-obsidian",
  "version": "1.0.2",
  "description": "A keyboard-first task manager stored entirely as Markdown: projects, tasks, boards, calendars, timelines, chart dashboards, saved views, and an offline help system.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/build-help.mjs && node scripts/build-templates.mjs && tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "node scripts/build-help.mjs && node scripts/build-templates.mjs && tsc --noEmit",
    "build:help": "node scripts/build-help.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:templates": "node scripts/build-templates.mjs",
    "generate:repomix": "pnpx repomix --style markdown --no-gitignore"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "task-management",
    "kanban"
  ],
  "author": "JR Leonard",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-rough-notation": "^1.0.8",
    "recharts": "^3.10.1",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
